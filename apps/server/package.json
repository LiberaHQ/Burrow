{
  "name": "@burrow/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "dev": "mac-peripheral/build.sh && tsx watch src/index.ts",
    "build": "mac-peripheral/build.sh && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:mac-app": "pnpm build && open mac-wrapper/BurrowServer.app",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@abandonware/noble": "1.9.2-26",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.2",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.1.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
